# 실제 값은 EC2 서버에서 nano로 /srv/duckswell/.env.prod를 직접 만들어 채운다.
# 이 파일(.env.prod.example)은 어떤 키가 필요한지 보여주는 템플릿일 뿐, 실제 값은 절대 커밋하지 않는다.

# --- DB ---
DB_URL=jdbc:mysql://mysql:3306/duckswell?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# --- OpenAI / Weather ---
OPENAI_API_KEY=
WEATHER_API_KEY=

# --- AWS S3 (Access Key/Secret 방식 - IAM 유저에 duckswell 버킷 최소 권한만 부여) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI 사진 분석(CV) - 이미지에 이미 심어둔 경로와 같으면 굳이 안 바꿔도 됨 ---
DUCKSWELL_AI_PYTHON_PATH=/opt/venv/bin/python
DUCKSWELL_AI_SCRIPTS_PATH=/app/ai/scripts
